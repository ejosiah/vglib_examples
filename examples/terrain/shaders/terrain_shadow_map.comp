#version 460

#extension GL_EXT_nonuniform_qualifier : enable
#extension GL_EXT_debug_printf : enable

#define displacement_map global_textures[nonuniformEXT(dmap_tex_index)]
#define shadow_map  global_images[nonuniformEXT(shadow_image_index)]

layout(local_size_x = 16, local_size_y = 16) in;

layout(set = 0, binding = 10) uniform sampler2D global_textures[];
layout(set = 0, binding = 11) uniform writeonly image2D global_images[];

// --- Parameters ---------------------------------------------------------------
// Height units: worldY = heightTex * heightScale
// Horizontal units: each texel step in X/Z equals uXZScale world units.
struct Frustum { vec4 p[6]; };
layout(push_constant) uniform Constants {
    Frustum frustum;
    vec3  lightDir;     // normalized direction FROM point TOWARD light (e.g., sun)
    float stepStride;   // step size in texels along X/Z (e.g., 1.0)
    vec2 heightRange;  // world units per height [0..1]
    vec2 xzScale;      // world units per texel in X/Z
    int   maxSteps;     // e.g., 256 (tradeoff: quality vs. speed)
    float slopeBias;    // small bias to avoid self-shadowing (e.g., 0.001)
    float softness;     // >0 enables soft shadows; try 0.05..0.2, 0 disables
    uint enabled;
    uint dmap_tex_index;
    uint shadow_image_index;
};

// clamp helper
float saturate(float x) { return clamp(x, 0.0, 1.0); }

vec3 toWorldCoords(vec2 uv, float h) {
    ivec2 size = textureSize(displacement_map, 0);
    h = mix(heightRange.x, heightRange.y, h);
    vec3 p = vec3(uv.x, h, 1 - uv.y);
    p.xz -= 0.5; // [0, 1] -> [-0.5, 0.5]
    p.xz *= xzScale * vec2(size);
    return p;
}

bool inFrustumClip(vec3 worldPos, mat4 VP){
    vec4 c = VP * vec4(worldPos, 1.0);
    // perspective: w <= 0 means behind the eye
    if (c.w <= 0.0) return false;

    if ( c.x < -c.w || c.x > c.w ) return false;
    if ( c.y < -c.w || c.y > c.w ) return false;
    if ( c.z < 0.0  || c.z > c.w ) return false;

    return true;
}

Frustum makeFrustum(mat4 VP) {
    Frustum f;
    // Column-major indexing: VP[0..3] are columns
    f.p[0] = VP[3] + VP[0]; // Left
    f.p[1] = VP[3] - VP[0]; // Right
    f.p[2] = VP[3] + VP[1]; // Bottom
    f.p[3] = VP[3] - VP[1]; // Top
    f.p[4] = VP[3] + VP[2]; // Near  (handles GL/VK; the P matrix encodes the convention)
    f.p[5] = VP[3] - VP[2]; // Far

    // Normalize planes so distance is in *world units*
    for (int i = 0; i < 6; ++i) {
        float invLen = inversesqrt(dot(f.p[i].xyz, f.p[i].xyz));
        f.p[i] *= invLen;
    }
    return f;
}

// Returns true if inside a *padded* frustum.
// padXY_m: expand L/R/T/B by this world distance (meters)
// nearBehind_m: allow this much *behind the near plane* (toward camera)
// farPad_m: expand the far plane by this many meters
bool inFrustumPaddedWorld(vec3 worldPos, float padXY_m, float nearBehind_m, float farPad_m)
{
    Frustum F = frustum;

    // Left, Right, Bottom, Top: allow padXY_m outside
    if (dot(F.p[0], vec4(worldPos,1.0)) < -padXY_m) return false; // Left
    if (dot(F.p[1], vec4(worldPos,1.0)) < -padXY_m) return false; // Right
    if (dot(F.p[2], vec4(worldPos,1.0)) < -padXY_m) return false; // Bottom
    if (dot(F.p[3], vec4(worldPos,1.0)) < -padXY_m) return false; // Top

    // Near: allow *negative* distance up to nearBehind_m (i.e., a slice in front of the eye)
    if (dot(F.p[4], vec4(worldPos,1.0)) < -nearBehind_m) return false;

    // Far: allow farPad_m beyond far plane
    if (dot(F.p[5], vec4(worldPos,1.0)) < -farPad_m) return false;

    return true;
}


bool inBounds(vec2 uv, float h) {
    vec3 p = toWorldCoords(uv, h);

    float texelWorld = max(xzScale.x, xzScale.y);   // meters per texel
    float padXY      = 2.0 * texelWorld;            // 2 texels guard
    float nearBehind = 4.0 * texelWorld;            // admit 4 texels behind near
    float farPad     = 20.0 * texelWorld;

    return inFrustumPaddedWorld(p, padXY, nearBehind, farPad);

//    return inFrustumClip(p, viewProjection);
}

bool  leftBounds = false;
void main() {
    ivec2 size = textureSize(displacement_map, 0);
    ivec2 gid  = ivec2(gl_GlobalInvocationID.xy);

    if(enabled != 1) {
        imageStore(shadow_map, gid, vec4(1.0, 0.0, 0.0, 1.0));
        return;
    }

    if (gid.x >= size.x || gid.y >= size.y) return;

    float heightScale = heightRange.y - heightRange.x;

    // Centered UV and initial height
    vec2 uv   = (vec2(gid) + 0.5) / vec2(size);
    float h0  = texture(displacement_map, uv).r;

    if(!inBounds(uv, h0)){
        imageStore(shadow_map, gid, vec4(1.0, 1.0, 0.0, 1.0));
        return;
    }

    h0 *= heightScale;

    // Projected light direction on XZ plane (heightmap plane)
    vec2 Lxz     = lightDir.xz;
    Lxz.y = -Lxz.y;
    float lenLxz = length(Lxz);

    // If light is perfectly vertical, there are no lateral occluders in the height field
    if (lenLxz < 1e-5) {
        imageStore(shadow_map, gid, vec4(1.0, 0.0, 0.0, 1.0));
        return;
    }

    vec2  v          = normalize(Lxz);                          // march direction in XZ
    vec2  texelSize  = 1.0 / vec2(size);
    vec2  duv        = v * texelSize * stepStride;          // step in texture space
    float hStepWorld = stepStride * length(vec2(v.x * xzScale.x, v.y * xzScale.y));
    float slopeLight = lightDir.y / lenLxz - slopeBias; // target slope (Y per XZ)

    float maxSlope = -1e20; // running maximum slope to the horizon
    vec2  posUV    = uv;

    // March toward the light
    for (int i = 1; i <= maxSteps; ++i) {
        posUV += duv;
        // If we leave the heightfield, we can consider the point lit
        if (any(lessThan(posUV, vec2(0.0))) || any(greaterThan(posUV, vec2(1.0)))) {
            leftBounds = true;
            break;
        }

        float s_world = float(i) * hStepWorld; // horizontal distance in world units
        float h1      = texture(displacement_map, posUV).r * heightScale;
        float slope   = (h1 - h0) / max(s_world, 1e-6);          // slope from current texel to this sample
        // Track the steepest horizon
        maxSlope = max(maxSlope, slope);

        // Early exit if the horizon already exceeds the sun's slope
        if (maxSlope > slopeLight && softness <= 0.0) {
            imageStore(shadow_map, gid, vec4(0.0, 0.0, 0.0, 1.0));
            return;
        }
    }

    if (softness > 0.0) {
        float margin = slopeLight - maxSlope;                // >0 lit, <0 shadow
        float vis    = smoothstep(-softness, softness, margin);
        imageStore(shadow_map, gid, vec4(vis, 0.0, 0.0, 1.0));
    } else {
        imageStore(shadow_map, gid, vec4(maxSlope > slopeLight ? 0.0 : 1.0, 0.0, 0.0, 1.0));
    }
}
