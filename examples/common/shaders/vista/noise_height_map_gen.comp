#version 460

#extension GL_EXT_nonuniform_qualifier : require

#include "perlin_noise.glsl"

#define height_map global_images[nonuniformEXT(pc.dmap_image_index)]

layout(local_size_x = 32, local_size_y = 32) in;

layout(set = 0, binding = 11) writeonly uniform image2D global_images[];

layout(push_constant) uniform Constants {
    vec2 seed;
    float baseFrequency;
    float lacunarity;
    float gain;
    uint octaves;
    uint dmap_image_index;
    uint enableRidges;
} pc;

float noise(vec2 p) {
    vec2 i = floor(p);
    vec2 f = fract(p);
    vec2 u = f * f * (3.0 - 2.0 * f);

    float a = hash12(i + pc.seed);
    float b = hash12(i + vec2(1.0, 0.0) + pc.seed);
    float c = hash12(i + vec2(0.0, 1.0) + pc.seed);
    float d = hash12(i + vec2(1.0, 1.0) + pc.seed);

    return mix(mix(a, b, u.x), mix(c, d, u.x), u.y);
}

float fbm(vec2 p) {
    float value = 0.0;
    float amplitude = 0.5;
    float normalization = 0.0;
    float frequency = max(pc.baseFrequency, 0.001);
    uint octaves = clamp(pc.octaves, 1u, 12u);

    for(uint i = 0u; i < octaves; ++i) {
        value += amplitude * noise(p * frequency);
        normalization += amplitude;
        frequency *= max(pc.lacunarity, 1.001);
        amplitude *= clamp(pc.gain, 0.0, 1.0);
    }

    return value / max(normalization, 0.0001);
}

vec2 seededRandomVec(vec2 p, vec2 seed) {
    return 2.0 * hash22(p + seed) - 1.0;
}

float seededPerlin(vec2 p, vec2 seed) {
    vec2 i = floor(p);
    vec2 f = fract(p);

    vec2 g0 = seededRandomVec(i + vec2(0.0, 0.0), seed);
    vec2 g1 = seededRandomVec(i + vec2(1.0, 0.0), seed);
    vec2 g2 = seededRandomVec(i + vec2(0.0, 1.0), seed);
    vec2 g3 = seededRandomVec(i + vec2(1.0, 1.0), seed);

    vec2 f0 = f - vec2(0.0, 0.0);
    vec2 f1 = f - vec2(1.0, 0.0);
    vec2 f2 = f - vec2(0.0, 1.0);
    vec2 f3 = f - vec2(1.0, 1.0);

    float g0f0 = dot(g0, f0);
    float g1f1 = dot(g1, f1);
    float g2f2 = dot(g2, f2);
    float g3f3 = dot(g3, f3);

    vec2 uv = f * f * f * (10.0 - 3.0 * f * (5.0 - 2.0 * f));
    return mix(mix(g0f0, g1f1, uv.x), mix(g2f2, g3f3, uv.x), uv.y);
}

float seededPerlinFbm(vec2 p, vec2 seed) {
    float normalization = 0.0;
    float amplitude = 1.0;
    float frequency = max(pc.baseFrequency, 0.001);
    int octaves = int(clamp(pc.octaves, 1u, 12u));
    float persistence = clamp(pc.gain, 0.0, 1.0);
    float lacunarity = max(pc.lacunarity, 1.001);
    float value = 0.0;

    for(int i = 0; i < octaves; ++i) {
        value += amplitude * seededPerlin(p * frequency, seed);
        normalization += amplitude;
        frequency *= lacunarity;
        amplitude *= persistence;
    }

    return clamp(value / max(normalization, 0.0001) + 0.5, 0.0, 1.0);
}

float continental_shape(vec2 p) {
    float n0 = seededPerlinFbm(p, pc.seed);
    float n1 = seededPerlinFbm(p * 2.17, pc.seed + vec2(19.13, 71.89)) * 0.5;
    float n2 = seededPerlinFbm(p * 4.31, pc.seed + vec2(-7.91, 31.37)) * 0.25;

    float h = (n0 + n1 + n2) / 1.75f;

    // remap to broad land/ocean mask
    h = smoothstep(0.35, 0.75, h);

    return h;
}

float ridge(float n)
{
    n = abs(n * 2.0 - 1.0); // 0 at center, 1 at extremes
    return 1.0 - n;         // invert so ridge peaks at center
}

float ridged_multifractal(vec2 p) {
    float sum = 0.0;
    float amp = 0.5;
    float freq = 1.0;

    for (int i = 0; i < 6; ++i)
    {
        float n = fbm(p * freq);
        float r = ridge(n);
        r *= r; // sharpen ridges

        sum += r * amp;

        freq *= 2.0;
        amp *= 0.5;
    }

    return sum;
}

void main() {
    ivec2 gid = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(height_map);
    if(any(greaterThanEqual(gid, size))) {
        return;
    }

    vec2 uv = (vec2(gid) + 0.5) / vec2(size);
    vec2 aspect = vec2(float(size.x) / float(max(size.y, 1)), 1.0);

    vec2 p = uv * aspect;
    float continental = continental_shape(p);

    float height = continental;
    if(pc.enableRidges == 1) {
        float ridges = ridged_multifractal(p * 8.0);
        height += ridges * continental * 0.35f;
    }

    height = clamp(height, 0.0, 1.0);

    imageStore(height_map, gid, vec4(height));
}
