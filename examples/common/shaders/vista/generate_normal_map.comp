#version 460

#extension GL_EXT_nonuniform_qualifier : enable

#define MAX_RADIUS 12

layout(local_size_x = 16, local_size_y = 16) in;

layout(set = 0, binding = 10) uniform sampler2D global_textures[];
layout(set = 0, binding = 11) uniform writeonly image2D global_images[];

float heightScale = 1601;
float terrainSize = 52660;

#define depth_map global_textures[pc.dmap_tex_id]

layout(push_constant) uniform Contanst {
    float bumpStrength;
    float sigma;
    int sampleRadius;
    uint dmap_tex_id;
    uint nornal_image_id;
} pc;

vec3 depthToNormalGaussian(vec2 uv) {
    ivec2 szI   = textureSize(depth_map, 0);
    vec2  texel = 1.0 / vec2(szI);

    int radius = clamp(pc.sampleRadius, 1, MAX_RADIUS);
    float sigma = max(pc.sigma, 0.001);
    float twoSigma2 = 2.0 * sigma * sigma;
    float invSigma2 = 1.0 / (sigma * sigma);

    float dx = 0.0;
    float dy = 0.0;
    float normX = 0.0;
    float normY = 0.0;

    // Derivative-of-Gaussian (separable): G'(x) * G(y) for dx, G(x) * G'(y) for dy
    for (int jy = -MAX_RADIUS; jy <= MAX_RADIUS; ++jy) {
        if (abs(jy) > radius) continue;
        float y  = float(jy);
        float gy = exp(-(y*y) / twoSigma2);
        float dgy = -y * invSigma2 * gy;

        for (int jx = -MAX_RADIUS; jx <= MAX_RADIUS; ++jx) {
            if (abs(jx) > radius) continue;
            float x  = float(jx);
            float gx = exp(-(x*x) / twoSigma2);
            float dgx = -x * invSigma2 * gx;

            float h = texture(depth_map, uv + vec2(x, y) * texel).r;

            dx += dgx * gy * h;
            dy += dgy * gx * h;

            normX += abs(dgx) * gy;
            normY += abs(dgy) * gx;
        }
    }

    // Normalize gradient magnitude so strength is stable across radii/sigmas
    if (normX > 0.0) dx /= normX;
    if (normY > 0.0) dy /= normY;

    dx *= heightScale/terrainSize;
    dy *= heightScale/terrainSize;

    dx *= pc.bumpStrength;
    dy *= pc.bumpStrength;

    vec3 n = normalize(vec3(-dx, -dy, 1.0));
    return 0.5 + 0.5 * n; // pack to 0..1
}

vec3 depthToNormal(vec2 uv) {
    float heightL = texture(depth_map, uv + vec2(-1.0, 0.0) / textureSize(depth_map, 0)).r;
    float heightR = texture(depth_map, uv + vec2(1.0, 0.0) / textureSize(depth_map, 0)).r;
    float heightD = texture(depth_map, uv + vec2(0.0, -1.0) / textureSize(depth_map, 0)).r;
    float heightU = texture(depth_map, uv + vec2(0.0, 1.0) / textureSize(depth_map, 0)).r;

    // Calculate the gradients (dx, dy) with added bump strength factor
    float dx = (heightR - heightL) * pc.bumpStrength;
    float dy = (heightU - heightD) * pc.bumpStrength;

    dx *= heightScale/terrainSize;
    dy *= heightScale/terrainSize;

    vec3 normal = normalize(vec3(-dx, -dy, 1.0));

    return 0.5 + 0.5 * normal;
}

void main() {
    ivec2 gid = ivec2(gl_GlobalInvocationID);
    vec2 uv = (0.5 + vec2(gid))/textureSize(depth_map, 0);

    vec3 normal = depthToNormal(uv);
    imageStore(global_images[pc.nornal_image_id], gid, vec4(normal, 0));
}