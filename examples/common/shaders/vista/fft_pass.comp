#version 460

#extension GL_EXT_nonuniform_qualifier : require

#define fft_input global_textures[nonuniformEXT(pc.input_tex_id)]
#define fft_output global_images[nonuniformEXT(pc.output_image_index)]

layout(local_size_x = 32, local_size_y = 32) in;

layout(set = 0, binding = 10) uniform sampler2D global_textures[];
layout(set = 0, binding = 11, rg32f) writeonly uniform image2D global_images[];

layout(push_constant) uniform Constants {
    uint input_tex_id;
    uint output_image_index;
    uint size;
    uint pass;
    uint horizontal;
} pc;

const float TWO_PI = 6.28318530717958647692;

vec2 complexMul(vec2 lhs, vec2 rhs) {
    return vec2(lhs.x * rhs.x - lhs.y * rhs.y, lhs.x * rhs.y + lhs.y * rhs.x);
}

void main() {
    ivec2 gid = ivec2(gl_GlobalInvocationID.xy);
    uint size = pc.size;
    if(any(greaterThanEqual(gid, ivec2(size)))) {
        return;
    }

    uint axis = pc.horizontal == 1u ? uint(gid.x) : uint(gid.y);
    uint butterflySize = 1u << (pc.pass + 1u);
    uint halfButterflySize = butterflySize >> 1u;
    uint localIndex = axis & (butterflySize - 1u);
    uint twiddleIndex = localIndex & (halfButterflySize - 1u);
    uint base = axis - localIndex;

    uint axis0 = base + twiddleIndex;
    uint axis1 = axis0 + halfButterflySize;

    ivec2 coord0 = gid;
    ivec2 coord1 = gid;
    if(pc.horizontal == 1u) {
        coord0.x = int(axis0);
        coord1.x = int(axis1);
    }else {
        coord0.y = int(axis0);
        coord1.y = int(axis1);
    }

    vec2 a = texelFetch(fft_input, coord0, 0).rg;
    vec2 b = texelFetch(fft_input, coord1, 0).rg;
    float angle = TWO_PI * float(twiddleIndex) / float(butterflySize);
    b = complexMul(b, vec2(cos(angle), sin(angle)));

    vec2 result = localIndex < halfButterflySize ? a + b : a - b;
    imageStore(fft_output, gid, vec4(result, 0.0, 1.0));
}
