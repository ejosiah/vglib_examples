#version 460

#extension GL_EXT_nonuniform_qualifier : require
#extension GL_GOOGLE_include_directive : enable

#include "hash.glsl"

#define spectrum_out global_images[nonuniformEXT(pc.output_image_index)]

layout(local_size_x = 32, local_size_y = 32) in;

layout(set = 0, binding = 11, rg32f) writeonly uniform image2D global_images[];

layout(push_constant) uniform Constants {
    vec2 seed;
    float amplitude;
    float spectralPower;
    float frequencies[6];
    uint frequencyCount;
    uint output_image_index;
    uint size;
} pc;

const float PI = 3.14159265358979323846;
const float TWO_PI = 6.28318530717958647692;

ivec2 conjugateCoord(ivec2 coord, int size) {
    return ivec2((size - coord.x) & (size - 1), (size - coord.y) & (size - 1));
}

bool lexicographicLess(ivec2 lhs, ivec2 rhs) {
    return lhs.y < rhs.y || (lhs.y == rhs.y && lhs.x <= rhs.x);
}

ivec2 signedFrequency(ivec2 coord, int size) {
    ivec2 k = coord;
    if(k.x > size / 2) {
        k.x -= size;
    }
    if(k.y > size / 2) {
        k.y -= size;
    }
    return k;
}

float frequencyBand(float k) {
    float logK = log(max(k, 0.001));
    uint frequencyCount = clamp(pc.frequencyCount, 1u, 6u);
    float band = 0.0;

    for(uint i = 0u; i < 6u; ++i) {
        if(i >= frequencyCount) {
            break;
        }

        float frequency = max(pc.frequencies[i], 0.001);
        float center = log(frequency);
        float lowerEdge = i == 0u ? center - log(2.0) : 0.5 * (log(max(pc.frequencies[i - 1u], 0.001)) + center);
        float upperEdge = i + 1u >= frequencyCount ? center + log(2.0) : 0.5 * (center + log(max(pc.frequencies[i + 1u], 0.001)));
        float width = max(min(center - lowerEdge, upperEdge - center), 0.001);
        float normalizedDistance = (logK - center) / width;
        band = max(band, exp(-0.5 * normalizedDistance * normalizedDistance));
    }

    return clamp(band, 0.0, 1.0);
}

void main() {
    ivec2 gid = ivec2(gl_GlobalInvocationID.xy);
    int size = int(pc.size);
    if(any(greaterThanEqual(gid, ivec2(size)))) {
        return;
    }

    ivec2 paired = conjugateCoord(gid, size);
    bool canonical = lexicographicLess(gid, paired);
    ivec2 source = canonical ? gid : paired;
    ivec2 k2 = signedFrequency(source, size);
    float k = length(vec2(k2));

    vec2 value = vec2(0.0);
    if(k > 0.0) {
        float band = frequencyBand(k);

        vec4 randomValues = hash42(vec2(source) + pc.seed);
        float phase = randomValues.x * TWO_PI;
        float gaussian = sqrt(max(-2.0 * log(max(randomValues.y, 0.000001)), 0.0));
        float magnitude = pc.amplitude * float(size * size) * gaussian * band / pow(k, max(pc.spectralPower, 0.001));

        value = magnitude * vec2(cos(phase), sin(phase));
        if(!canonical) {
            value.y = -value.y;
        }
        if(all(equal(gid, paired))) {
            value.y = 0.0;
        }
    }

    imageStore(spectrum_out, gid, vec4(value, 0.0, 1.0));
}
