float get_directional_light_visibility(Light light, uint sample_count, vec3 world_position, vec3 normal, uint frame_index) {
    vec3 L = normalize(-light.direction);
    vec3 N = normalize(normal);
    float NdotL = dot(N, L);

    if (NdotL <= 0.001f) return 0;

    vec3 x_axis =  L.y == 1.0f ? normalize(cross(L, vec3(0.0f, 0.0f, 1.0f))) : normalize(cross(L, vec3(0.0f, 1.0f, 0.0f)));
    vec3 y_axis = normalize(cross(x_axis, L));
    float visibility = 0;
    for (uint s = 0; s < sample_count; ++s) {
        vec2 poisson_sample = POISSON_SAMPLES[(s * FRAME_HISTORY_COUNT + frame_index) % SAMPLE_NUM];
        vec3 random_x = x_axis * poisson_sample.x * 0.01;
        vec3 random_y = y_axis * poisson_sample.y * 0.01;
        vec3 random_dir = normalize(L + random_x + random_y);

        rayQuery rQuery;
        rayQueryInitialize(rQuery, tlas, gl_RayFlagsTerminateOnFirstHit, 0xff, world_position, 0.01, random_dir, 100.0);
        while (rayQueryProceed(rQuery)) { };

        if (rayQueryGetIntersectionType(rQuery, true) == gl_RayQueryCommittedIntersectionNone) {
            visibility += 1.0f;
        }
    }

    return visibility / float(sample_count);
}

float get_point_light_visibility(Light light, uint sample_count, vec3 world_position, vec3 normal, uint frame_index) {
    const vec3 position_to_light = light.position - world_position;
    const vec3 L = normalize(position_to_light);
    const vec3 N = normalize(normal);
    const float NdotL = dot(N, L);

    if (NdotL <= 1e-4) return 0.0;

    float d = length(position_to_light);

    if (d <= 1e-4) return 1.0;

    vec3 x_axis = normalize(cross(L, vec3(0.0f, 1.0f, 0.0f)));
    vec3 y_axis = normalize(cross(x_axis, L));

    float attenuation = getRangeAttenuation(light.range, d);

    if (attenuation <= 1e-4) return 0.0;

    const float scaled_distance = light.range != 0 ? light.range / d : 1;
    float visibility = 0.0;

    float t = 0;
    for (uint s = 0; s < sample_count; ++s) {
        vec2 poisson_sample = POISSON_SAMPLES[(s * FRAME_HISTORY_COUNT + frame_index) % SAMPLE_NUM];
        vec3 random_x = x_axis * poisson_sample.x * (scaled_distance) * 0.01;
        vec3 random_y = y_axis * poisson_sample.y * (scaled_distance) * 0.01;
        vec3 random_dir = normalize(L + random_x + random_y);

        rayQuery rQuery;
        rayQueryInitialize(rQuery, tlas, gl_RayFlagsTerminateOnFirstHit, 0xff, world_position, 0.01, random_dir, d);
        while (rayQueryProceed(rQuery)) { };

        t = rayQueryGetIntersectionT(rQuery, true);
        if (rayQueryGetIntersectionType(rQuery, true) == gl_RayQueryCommittedIntersectionNone) {
            visibility += 1.0f;
        }
    }

    return visibility / float(sample_count);
}

