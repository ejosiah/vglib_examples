float get_light_visibility(uint light_index, uint sample_count, vec3 world_position, vec3 normal, uint frame_index) {
    Light light = lightAt(int(light_index));
    switch (light.type) {
        case LightType_Directional:
        return get_directional_light_visibility(light, sample_count, world_position, normal, frame_index);
        case LightType_Point:
        return get_point_light_visibility(light, sample_count, world_position, normal, frame_index);
        case LightType_Spot:
        return get_spot_light_visibility(light, sample_count, world_position, normal, frame_index);
        default :
        return 0;
    }
}

