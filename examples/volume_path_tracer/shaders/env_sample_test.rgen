#version 460
#extension GL_EXT_ray_tracing : require
#extension GL_EXT_debug_printf : require

#include "ray_tracing_lang.glsl"
#include "domain.glsl"

layout(set = 0, binding = 0) uniform accelerationStructure topLevelAs;
layout(set = 0, binding = 2, rgba32f) uniform image2D image;

layout(location = 0) rayPayload vec3 hitValue;

void main(){
    if(currentSample >= sampleCount) return;

    vec2 id = vec2(gl_LaunchID.xy);
    vec2 screenSize = vec2(gl_LaunchSize.xy);

    RngStateType rngState = initRNG(id, screenSize, frame);

    vec2 u = vec2(rand(rngState), rand(rngState));

    float pdf;
    vec2 uv = sampleHierarchicalMipMappedTexture(distribution, u, pdf);
    vec3 color = texture(environment, uv).rgb/pdf;

    if(currentSample > 0) {
        vec3 dst = imageLoad(image, ivec2(gl_LaunchID.xy)).rgb;
        float t = 1.0/float(currentSample+1);
        color = mix(dst, color, t);
    }

    imageStore(image, ivec2(gl_LaunchID.xy), vec4(color, 1.0));

}