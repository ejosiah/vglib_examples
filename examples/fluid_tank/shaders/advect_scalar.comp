#version 460

layout(local_size_x = 4, local_size_y = 4, local_size_z = 4) in;

#include "sim.glsl"

layout(push_constant) uniform AdvectSign {
    float direction;
} pc;

layout(set = 1, binding = 5, r32f) uniform writeonly image3D outImage;

void main() {
    ivec3 id = ivec3(gl_GlobalInvocationID.xyz);
    if (outOfBounds(id)) {
        return;
    }

    if (obstacleAt(id) > 0.5) {
        imageStore(outImage, id, vec4(0.0));
        return;
    }

    vec3 uvw = uvwFromId(id);
    vec3 vel = texture(velocityTex, uvw).xyz;
    vec3 prev = clamp(uvw - pc.direction * sim.invGridSizeDt.w * vel, vec3(0.0), vec3(1.0));
    float advected = texture(sourceTex, prev).r * sim.fluidParams.w;
    imageStore(outImage, id, vec4(advected));
}
