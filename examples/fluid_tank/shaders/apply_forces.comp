#version 460

layout(local_size_x = 4, local_size_y = 4, local_size_z = 4) in;

#include "sim.glsl"

layout(set = 1, binding = 5, rgba32f) uniform writeonly image3D outImage;

void main() {
    ivec3 id = ivec3(gl_GlobalInvocationID.xyz);
    if (outOfBounds(id)) {
        return;
    }

    if (obstacleAt(id) > 0.5) {
        imageStore(outImage, id, vec4(0.0));
        return;
    }

    vec3 uvw = uvwFromId(id);
    vec3 vel = texture(velocityTex, uvw).xyz;
    float rho = texture(sourceTex, uvw).r;

    vel.y += sim.fluidParams.y * sim.invGridSizeDt.w * rho;

    vec3 delta = uvw - sim.spherePosRadius.xyz;
    float dist = length(delta);
    float influence = exp(-dist * dist / max(0.0001, sim.spherePosRadius.w * sim.spherePosRadius.w * 2.5));
    vec3 radial = dist > 1e-4 ? normalize(delta) : vec3(0.0, 1.0, 0.0);
    vel += (sim.sphereVelocity.xyz * 1.4 + radial * abs(sim.sphereVelocity.y) * 0.5) * influence * sim.fluidParams.z * sim.invGridSizeDt.w;

    imageStore(outImage, id, vec4(vel, 1.0));
}
