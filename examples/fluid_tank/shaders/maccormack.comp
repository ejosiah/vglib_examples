#version 460

layout(local_size_x = 4, local_size_y = 4, local_size_z = 4) in;

#include "sim.glsl"

layout(set = 1, binding = 5, r32f) uniform writeonly image3D outImage;

float sourceAt(ivec3 id) {
    if (outOfBounds(id)) {
        return 0.0;
    }
    return texture(sourceTex, uvwFromId(id)).r;
}

float clampNeighborhood(ivec3 id, float value) {
    float minV = 1e9;
    float maxV = -1e9;

    for (int z = 0; z <= 1; ++z) {
        for (int y = 0; y <= 1; ++y) {
            for (int x = 0; x <= 1; ++x) {
                ivec3 c = clamp(id + ivec3(x, y, z), ivec3(0), sim.gridSize.xyz - 1);
                float s = sourceAt(c);
                minV = min(minV, s);
                maxV = max(maxV, s);
            }
        }
    }

    return clamp(value, minV, maxV);
}

void main() {
    ivec3 id = ivec3(gl_GlobalInvocationID.xyz);
    if (outOfBounds(id)) {
        return;
    }

    if (obstacleAt(id) > 0.5) {
        imageStore(outImage, id, vec4(0.0));
        return;
    }

    vec3 uvw = uvwFromId(id);
    float original = texture(sourceTex, uvw).r;
    float forward = texture(pressureTex, uvw).r;
    float reverse = texture(divergenceTex, uvw).r;
    float corrected = forward + 0.5 * (original - reverse);
    corrected = clampNeighborhood(id, corrected);
    imageStore(outImage, id, vec4(corrected * sim.fluidParams.w));
}
