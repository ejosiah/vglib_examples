void ClassifyElement(uint currentID, BisectorGeometry bis, uint totalNumElements, uint baseDepth);

layout(local_size_x = WORKGROUP_SIZE) in;
uint currentID;
void main() {
    currentID = gl_GlobalInvocationID.x;
    if (currentID >= _IndirectDrawBuffer[9]) return;

    currentID = _BisectorIndicesBuffer[currentID];

    BisectorGeometry bis;
    bis.p[0] = _CurrentVertexBuffer[3 * currentID];
    bis.p[1] = _CurrentVertexBuffer[3 * currentID + 1];
    bis.p[2] = _CurrentVertexBuffer[3 * currentID + 2];
    bis.p[3] = _CurrentVertexBuffer[3 * _TotalNumElements + currentID];

    ClassifyElement(currentID, bis, _TotalNumElements, _BaseDepth);
}


vec3 NegativeVertex(vec3 bmin, vec3 bmax, vec3 n)
{
    bvec3 b = greaterThan(n, vec3(0));
    return mix(bmin, bmax, b);
}

