bool FrustumAABBIntersect(in vec4 frustumPlanes[6], vec3 aabbMin, vec3 aabbMax)
{
    vec3 center = (aabbMax + aabbMin) * 0.5;
    vec3 extents = (aabbMax - aabbMin) * 0.5;
    for (int i = 0; i < 4; i++)
    {
        vec4 plane = frustumPlanes[i];
        vec3 normal_sign = sign(plane.xyz);
        vec3 test_point = center + extents * normal_sign;

        float dotProd = dot(test_point, plane.xyz);
        if (dotProd + plane.w < 0)
        return false;
    }
    return true;
}


void logValididty(BisectorGeometry t, int valididty)  {
//    if(currentID != 0 || currentID != 1 || currentID != 2 || currentID != 3) return;
    switch (valididty) {
        case BACK_FACE_CULLED:
            debugPrintfEXT("frame: %u, id: %u, tri: [[%.2f, %.2f,%.2f], [%.2f, %.2f,%.2f], [%.2f, %.2f,%.2f]] -> BACK_FACE_CULLED\n",
            _FrameIndex, currentID,
            t.p[0].x, t.p[0].y, t.p[0].z,
            t.p[1].x, t.p[1].y, t.p[1].z,
            t.p[2].x, t.p[2].y, t.p[2].z
            );
            break;
        case FRUSTUM_CULLED:
            debugPrintfEXT("frame: %u, id: %u, tri: [[%.2f, %.2f,%.2f], [%.2f, %.2f,%.2f], [%.2f, %.2f,%.2f]] -> FRUSTUM_CULLED\n",
            _FrameIndex, currentID,
            t.p[0].x, t.p[0].y, t.p[0].z,
            t.p[1].x, t.p[1].y, t.p[1].z,
            t.p[2].x, t.p[2].y, t.p[2].z
            );
        break;
        case TOO_SMALL:
            debugPrintfEXT("frame: %u, id: %u, tri: [[%.2f, %.2f,%.2f], [%.2f, %.2f,%.2f], [%.2f, %.2f,%.2f]] -> TOO_SMALL\n",
            _FrameIndex, currentID,
            t.p[0].x, t.p[0].y, t.p[0].z,
            t.p[1].x, t.p[1].y, t.p[1].z,
            t.p[2].x, t.p[2].y, t.p[2].z
            );
            break;
        case UNCHANGED_ELEMENT:
            debugPrintfEXT("frame: %u, id: %u, tri: [[%.2f, %.2f,%.2f], [%.2f, %.2f,%.2f], [%.2f, %.2f,%.2f]] -> UNCHANGED_ELEMENT\n",
            _FrameIndex, currentID,
            t.p[0].x, t.p[0].y, t.p[0].z,
            t.p[1].x, t.p[1].y, t.p[1].z,
            t.p[2].x, t.p[2].y, t.p[2].z
            );
            break;
        case BISECT_ELEMENT:
            debugPrintfEXT("frame: %u, id: %u, tri: [[%.2f, %.2f,%.2f], [%.2f, %.2f,%.2f], [%.2f, %.2f,%.2f]] -> BISECT_ELEMENT\n",
            _FrameIndex, currentID,
            t.p[0].x, t.p[0].y, t.p[0].z,
            t.p[1].x, t.p[1].y, t.p[1].z,
            t.p[2].x, t.p[2].y, t.p[2].z
            );
            break;
        case SIMPLIFY_ELEMENT:
            debugPrintfEXT("frame: %u, id: %u, tri: [[%.2f, %.2f,%.2f], [%.2f, %.2f,%.2f], [%.2f, %.2f,%.2f]] -> SIMPLIFY_ELEMENT\n",
            _FrameIndex, currentID,
            t.p[0].x, t.p[0].y, t.p[0].z,
            t.p[1].x, t.p[1].y, t.p[1].z,
            t.p[2].x, t.p[2].y, t.p[2].z
            );
            break;
        case MERGED_ELEMENT:
            debugPrintfEXT("frame: %u, id: %u, tri: [[%.2f, %.2f,%.2f], [%.2f, %.2f,%.2f], [%.2f, %.2f,%.2f]] -> MERGED_ELEMENT\n",
            _FrameIndex, currentID,
            t.p[0].x, t.p[0].y, t.p[0].z,
            t.p[1].x, t.p[1].y, t.p[1].z,
            t.p[2].x, t.p[2].y, t.p[2].z
            );
            break;
    }
}

int ClassifyBisector(in BisectorGeometry tri, uint depth)
{
    vec3 triNormal = normalize(cross(tri.p[2] - tri.p[1], tri.p[0] - tri.p[1]));
    vec3 triCenter = (tri.p[0] + tri.p[1] + tri.p[2]) / 3.0;
    vec3 viewDir = normalize(-triCenter);
    float FdotV = dot(viewDir, _UpdateCameraForward);
    float VdotN = dot(viewDir, triNormal);

    if (FdotV < 0.0 && VdotN < -1e-3) return BACK_FACE_CULLED;

    vec3 aabbMin = vec3(min(min(tri.p[0].x, tri.p[1].x), tri.p[2].x), min(min(tri.p[0].y, tri.p[1].y), tri.p[2].y), min(min(tri.p[0].z, tri.p[1].z), tri.p[2].z));
    vec3 aabbMax = vec3(max(max(tri.p[0].x, tri.p[1].x), tri.p[2].x), max(max(tri.p[0].y, tri.p[1].y), tri.p[2].y), max(max(tri.p[0].z, tri.p[1].z), tri.p[2].z));

    if (!FrustumAABBIntersect(_FrustumPlanes, aabbMin, aabbMax)) return FRUSTUM_CULLED;

    vec4 p0P = _UpdateViewProjectionMatrix * vec4(tri.p[0], 1.0);
    p0P.xy = p0P.xy / p0P.w;
    p0P.xy = (p0P.xy * 0.5 + 0.5);

    vec4 p1P = _UpdateViewProjectionMatrix * vec4(tri.p[1], 1.0);
    p1P.xy = p1P.xy / p1P.w;
    p1P.xy = (p1P.xy * 0.5 + 0.5);

    vec4 p2P = _UpdateViewProjectionMatrix * vec4(tri.p[2], 1.0);
    p2P.xy = p2P.xy / p2P.w;
    p2P.xy = (p2P.xy * 0.5 + 0.5);

    float area = 0.5 * abs(p0P.x * (p2P.y - p1P.y) + p1P.x * (p0P.y - p2P.y) + p2P.x * (p1P.y - p0P.y));
    area *= _ScreenSize.x * _ScreenSize.y;

    float areaOverestimation = mix(2.0, 1.0, pow(max(VdotN, 0.0), 0.2));
    area *= areaOverestimation;

    if (_TriangleSize < area && depth < _MaxSubdivisionDepth) return BISECT_ELEMENT;

    if ((_TriangleSize * 0.5 > area) || (depth > _MaxSubdivisionDepth)) {
        vec4 p3P = _UpdateViewProjectionMatrix * vec4(tri.p[3], 1.0);
        p3P.xy = p3P.xy / p3P.w;
        p3P.xy = (p3P.xy * 0.5 + 0.5);

        float areaParent = 0.5 * abs(p0P.x * (p2P.y - p3P.y) + p3P.x * (p0P.y - p2P.y) + p2P.x * (p3P.y - p0P.y));
        areaParent *= _ScreenSize.x * _ScreenSize.y;
        areaParent *= areaOverestimation;

        return ((_TriangleSize >= areaParent) || (depth > _MaxSubdivisionDepth)) ? TOO_SMALL : UNCHANGED_ELEMENT;
    }

    return UNCHANGED_ELEMENT;
}

void ClassifyElement(uint currentID, BisectorGeometry bis, uint totalNumElements, uint baseDepth)
{
    uint64_t heapID = _HeapIDBuffer[currentID];
    uint depth = HeapIDDepth(heapID);
    BisectorData cbisectorData = _BisectorDataBuffer[currentID];

    cbisectorData.subdivisionPattern = 0;
    cbisectorData.bisectorState = UNCHANGED_ELEMENT;
    cbisectorData.problematicNeighbor = INVALID_POINTER;
    cbisectorData.flags = VISIBLE_BISECTOR;

    int currentValidity = ClassifyBisector(bis, depth);
    logValididty(bis, currentValidity);
    if (currentValidity > UNCHANGED_ELEMENT) {
        cbisectorData.bisectorState = BISECT_ELEMENT;
        uint targetSlot = atomicAdd(_ClassificationBuffer[SPLIT_COUNTER], 1);
        _ClassificationBuffer[CLASSIFY_COUNTER_OFFSET + targetSlot] = currentID;
    } else {
        cbisectorData.flags = currentValidity >= TOO_SMALL ? VISIBLE_BISECTOR : 0;
    }

    if (baseDepth != depth && currentValidity < UNCHANGED_ELEMENT) {
        cbisectorData.bisectorState = SIMPLIFY_ELEMENT;
        if (heapID % 2ul == 0) {
            uint targetSlot = atomicAdd(_ClassificationBuffer[SIMPLIFY_COUNTER], 1);
            _ClassificationBuffer[CLASSIFY_COUNTER_OFFSET + totalNumElements + targetSlot] = currentID;
        }
    }

    _BisectorDataBuffer[currentID] = cbisectorData;
}
