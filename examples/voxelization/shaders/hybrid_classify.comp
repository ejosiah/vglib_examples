#version 460

layout(local_size_x = 64) in;

struct Vertex {
    vec4 position;
    vec4 color;
    vec3 normal;
    vec3 tangent;
    vec3 bitangent;
    vec2 uv;
};

struct DrawIndexedIndirectCommand {
    uint indexCount;
    uint instanceCount;
    uint firstIndex;
    int vertexOffset;
    uint firstInstance;
};

layout(std430, set = 0, binding = 0) readonly buffer Vertices {
    Vertex vertices[];
};

layout(std430, set = 0, binding = 1) readonly buffer SourceIndices {
    uint sourceIndices[];
};

layout(std430, set = 0, binding = 2) buffer TriangleIndices {
    uint triangleIndices[];
};

layout(std430, set = 0, binding = 3) buffer FragmentIndices {
    uint fragmentIndices[];
};

layout(std430, set = 0, binding = 4) buffer Stats {
    uint triangleIndexCount;
    uint fragmentIndexCount;
    uint triangleCount;
    uint fragmentCount;
};

layout(std430, set = 0, binding = 5) buffer DrawCommands {
    DrawIndexedIndirectCommand draws[2];
};

layout(push_constant) uniform Constants {
    mat4 worldToVoxelTransform;
    float cutoffArea;
    uint voxelSize;
    uint triangleCountIn;
    uint _pad;
};

float projectedVoxelArea(vec3 p0, vec3 p1, vec3 p2) {
    vec3 n = cross(p1 - p0, p2 - p1);
    vec3 absN = abs(n);

    vec2 q0;
    vec2 q1;
    vec2 q2;
    if(absN.x >= absN.y && absN.x >= absN.z) {
        q0 = p0.yz;
        q1 = p1.yz;
        q2 = p2.yz;
    } else if(absN.y >= absN.x && absN.y >= absN.z) {
        q0 = p0.zx;
        q1 = p1.zx;
        q2 = p2.zx;
    } else {
        q0 = p0.xy;
        q1 = p1.xy;
        q2 = p2.xy;
    }

    vec2 e0 = q1 - q0;
    vec2 e1 = q2 - q0;
    return abs(e0.x * e1.y - e0.y * e1.x) * 0.5;
}

void appendTriangle(bool useTriangleParallel, uint i0, uint i1, uint i2) {
    if(useTriangleParallel) {
        uint dst = atomicAdd(triangleIndexCount, 3);
        atomicAdd(triangleCount, 1);
        atomicAdd(draws[0].indexCount, 3);
        triangleIndices[dst + 0] = i0;
        triangleIndices[dst + 1] = i1;
        triangleIndices[dst + 2] = i2;
    } else {
        uint dst = atomicAdd(fragmentIndexCount, 3);
        atomicAdd(fragmentCount, 1);
        atomicAdd(draws[1].indexCount, 3);
        fragmentIndices[dst + 0] = i0;
        fragmentIndices[dst + 1] = i1;
        fragmentIndices[dst + 2] = i2;
    }
}

void main() {
    uint triangleId = gl_GlobalInvocationID.x;
    if(triangleId >= triangleCountIn) {
        return;
    }

    uint base = triangleId * 3;
    uint i0 = sourceIndices[base + 0];
    uint i1 = sourceIndices[base + 1];
    uint i2 = sourceIndices[base + 2];

    float voxelScale = float(voxelSize);
    vec3 p0 = (worldToVoxelTransform * vec4(vertices[i0].position.xyz, 1)).xyz * voxelScale;
    vec3 p1 = (worldToVoxelTransform * vec4(vertices[i1].position.xyz, 1)).xyz * voxelScale;
    vec3 p2 = (worldToVoxelTransform * vec4(vertices[i2].position.xyz, 1)).xyz * voxelScale;

    appendTriangle(projectedVoxelArea(p0, p1, p2) < cutoffArea, i0, i1, i2);
}
