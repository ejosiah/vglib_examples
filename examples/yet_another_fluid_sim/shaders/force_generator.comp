#version 460
#extension GL_EXT_scalar_block_layout : enable
#extension GL_GOOGLE_include_directive : enable
#extension GL_EXT_nonuniform_qualifier : enable
#extension GL_EXT_samplerless_texture_functions : enable

#define FORCE_MODE_GRAVITY 0U
#define FORCE_MODE_WIND 1U
#define FORCE_MODE_POINT 2U

layout(local_size_x = 32, local_size_y = 32) in;

layout(set = 0, binding = 0) uniform sampler3D force_field_in;
layout(set = 1, binding = 2) uniform writeonly image3D force_field_out;
layout(set = 2, binding = 0) uniform sampler3D boundary_field;
layout(set = 3, binding = 0) uniform sampler3D vector_field_u;
layout(set = 4, binding = 0) uniform sampler3D vector_field_v;

layout(push_constant) uniform Constants {
    vec2 point;
    vec2 velocity;
    vec2 domainMin;
    vec2 domainMax;
    float speed;
    uint mode;
    float radius;
    float dt;
};

vec2 accumForce(ivec2 coord) {
    return texelFetch(force_field_in, ivec3(coord, 0), 0).xy;
}

vec2 vectorField(ivec2 coord) {
    return vec2(
        texelFetch(vector_field_u, ivec3(coord, 0), 0).x,
        texelFetch(vector_field_v, ivec3(coord, 0), 0).x);
}

ivec2 gid = ivec2(gl_GlobalInvocationID);
ivec2 grid_size = textureSize(force_field_in, 0).xy;
vec2 uv = (vec2(gid) + 0.5)/grid_size.xy;

float windInletWeight() {
    vec2 domainSize = max(domainMax - domainMin, vec2(0.000001));
    vec2 cellSize = domainSize / vec2(grid_size);
    float inletWidth = max(4.0 * cellSize.x, 0.05 * domainSize.x);
    float x = mix(domainMin.x, domainMax.x, uv.x) - domainMin.x;
    return 1.0 - smoothstep(0.0, inletWidth, x);
}

void main() {
    if(gid.x >= grid_size.x || gid.y >= grid_size.y) return;

    vec2 accumulated = accumForce(gid);

    vec2 du = accumulated;
    if(mode == FORCE_MODE_GRAVITY) {
        du += vec2(0.0, speed);
    } else if(mode == FORCE_MODE_WIND && gid.x > 0) {
        float inlet = windInletWeight();
        if(inlet > 0.0) {
            float responseTime = max(6.0 * dt, 0.05);
            du += inlet * (vec2(speed, 0.0) - vectorField(gid)) / responseTime;
        }
    }

    imageStore(force_field_out, ivec3(gid, 0), vec4(du,  0, 0));
}
